# Sealio — production / public-deploy environment variables
# Copy the relevant block into each Render service's "Environment" tab.
# (Local dev keeps using .env.local — do NOT use this file locally.)

# ─────────────────────────── API service (sealio-api) ───────────────────────────
NODE_ENV=production
PORT=3001

# Postgres (Render injects this automatically via the blueprint; shown for reference)
DATABASE_URL=postgres://sealio:password@host:5432/sealio

# RS256 keypair for signing JWTs (reuse the pair from .env.local, or generate a fresh one).
# Paste the full PEM including BEGIN/END lines.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the web app — used for CORS and for the signing links inside OTP/invite emails.
NEXT_PUBLIC_APP_URL=https://sealio-web-xxxx.onrender.com

# SMTP → the deployed Mailhog (internal network). No auth.
SMTP_HOST=sealio-mailhog-internal-hostname
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@sealio.local

# Object storage → Cloudflare R2 (S3-compatible)
MINIO_ENDPOINT=<accountid>.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_REGION=auto
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sealio-documents

# ─────────────────────────── Web service (sealio-web) ───────────────────────────
# NEXT_PUBLIC_* are inlined at BUILD time — set them before/at build.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=https://sealio-web-xxxx.onrender.com

# Server-side only: where the /api rewrite and the auth server actions reach the API.
INTERNAL_API_URL=http://sealio-api-internal-hostname:3001
API_URL=http://sealio-api-internal-hostname:3001

# The Live UI Test OTP proxy reads Mailhog's HTTP API.
MAILHOG_URL=http://sealio-mailhog-internal-hostname:8025
